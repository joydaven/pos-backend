# =============================================================================
# DS POS Backend - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real credentials.
#
# For staging/production, secrets are managed via Google Cloud Secret Manager.
# Set USE_GCP_SECRETS=true to enable (see core/secrets.py).
# =============================================================================

# --- Secret Manager Configuration ---
# Set to 'true' to fetch secrets from GCP Secret Manager instead of this file
USE_GCP_SECRETS=false
GCP_PROJECT_ID=doctors-studio-backend
APP_ENVIRONMENT=staging

# --- Django Core ---
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (POS Database) ---
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# --- PostgreSQL (GHL Database) ---
GHL_DB_NAME=your_ghl_db_name
GHL_DB_USER=your_ghl_db_user
GHL_DB_PASSWORD=your_ghl_db_password
GHL_DB_HOST=127.0.0.1
GHL_DB_PORT=5432

# --- WooCommerce Database (Cloud SQL — direct private IP) ---
WOO_DB_NAME=your_woo_db_name
WOO_DB_USER=your_woo_db_user
WOO_DB_PASSWORD=your_woo_db_password
WOO_DB_HOST=10.0.16.3
WOO_DB_PORT=3306

# --- WooCommerce REST API ---
WOO_API_URL=https://store.example.com
WOO_CONSUMER_KEY=ck_your_consumer_key
WOO_CONSUMER_SECRET=cs_your_consumer_secret
WOOCOMMERCE_API_VERSION=wc/v3
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret

# --- Authorize.net ---
AUTHORIZE_NET_LOGIN_ID=your_login_id
AUTHORIZE_NET_TRANSACTION_KEY=your_transaction_key
AUTHORIZE_NET_CLIENT_KEY=your_client_key
AUTHORIZE_NET_SANDBOX=True
AUTHORIZE_NET_CARD_VALIDATION_UPON_ADD=testMode
AUTHORIZE_NET_SIGNATURE_KEY=your_signature_key

# --- GoHighLevel API ---
GHL_API_TOKEN=your_ghl_api_token
GHL_DEFAULT_LOCATION_ID=your_ghl_location_id

# --- GoHighLevel OAuth2 ---
GHL_CLIENT_ID=your_ghl_client_id
GHL_CLIENT_SECRET=your_ghl_client_secret
GHL_REDIRECT_URI=http://localhost:8000/api/oauth/callback
GHL_INBOUND_WEBHOOK_SECRET=your_ghl_webhook_secret

# --- Email (Mailgun) ---
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=yourdomain.com
MAILGUN_API_URL=https://api.mailgun.net/v3

# --- Email (SMTP Fallback) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Your Name <your_email@example.com>

# --- Google OAuth2 ---
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret

# --- OAuth2 (Django Application) ---
CLIENT_ID=your_oauth2_client_id
CLIENT_SECRET=your_oauth2_client_secret
OAUTH2_CLIENT_ID=your_oauth2_client_id

# --- ShipStation ---
SHIPSTATION_API_KEY=your_shipstation_api_key
SHIPSTATION_API_SECRET=your_shipstation_api_secret
SHIPSTATION_WEBHOOK_SECRET=your_shipstation_webhook_secret
SHIPSTATION_TEST_MODE=True

# --- Sentry ---
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=staging

# --- Session / Cookie ---
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Misc ---
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
POS_ENABLE_SHIPPING=False
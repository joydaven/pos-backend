769,"key":"product_ingredients","value":"<div>\r\n  <h1 style=\"color: white\">Supplement Facts<\/h1>\r\n  <p><strong>Serving Size:<\/strong> 2 Capsules<\/p>\r\n  <p><strong>Servings Per Container:<\/strong> 30<\/p>\r\n  <p><strong>Amount Per Serving:<\/strong><\/p>\r\n\r\n  <ul>\r\n    <li><strong>Calcium (as calcium carbonate):<\/strong> 85 mg (7% Daily Value)<\/li>\r\n    <li><strong>Magnesium (as magnesium bisglycinate chelate and magnesium taurate)<sup>S1<\/sup>:<\/strong> 75 mg (18% Daily Value)<\/li>\r\n    <li><strong>Potassium (as potassium glycinate complex)<sup>S1<\/sup>:<\/strong> 45 mg (1% Daily Value)<\/li>\r\n    <li><strong>Valerian Extract (Valeriana officinalis) (root) (0.8% valerenic acids):<\/strong> 200 mg (**)<\/li>\r\n    <li><strong>Sour Cherry (Prunus cerasus) (cherry):<\/strong> 80 mg (**)<\/li>\r\n    <li><strong>Passion Flower Extract (Passiflora incarnata) (aerial part):<\/strong> 60 mg (**)<\/li>\r\n    <li><strong>Hops Extract (Humulus lupulus) (strobilus) (0.3% rutin):<\/strong> 30 mg (**)<\/li>\r\n  <\/ul>\r\n\r\n  <p>** Daily Value not established.<\/p>\r\n\r\n  <h3 style=\"color: white\">Other Ingredients<\/h3>\r\n  <p>Capsule (hypromellose and water), ascorbyl palmitate, and silica.<\/p>\r\n<\/div>\r\n"},{"id":227225,"key":"_main_inventory_expired_stock","value":""},{"id":227226,"key":"_main_inventory_is_expired","value":"no"},{"id":357568,"key":"_subscription_one_time_shipping","value":"no"},{"id":357569,"key":"_wcsatt_default_status","value":""},{"id":357571,"key":"_wcsatt_force_subscription","value":"no"},{"id":357572,"key":"_wcsatt_layout","value":"flat"},{"id":379150,"key":"_op_barcode","value":""},{"id":379151,"key":"_op_weight_base_pricing","value":"no"},{"id":379152,"key":"_op_qty_decimal","value":"no"},{"id":379153,"key":"_op_qty_warehouse_276941","value":""},{"id":379154,"key":"_hide_pos_website_276941","value":"yes"},{"id":379155,"key":"wcmo_product_restriction_method","value":"no-restriction"},{"id":379156,"key":"wcmo_
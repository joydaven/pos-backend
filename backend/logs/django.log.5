":36570,"key":"_et_pb_page_layout","value":"et_no_sidebar"},{"id":36571,"key":"_et_pb_side_nav","value":"off"},{"id":36572,"key":"_et_pb_use_builder","value":""},{"id":36573,"key":"_et_pb_first_image","value":""},{"id":36574,"key":"_et_pb_truncate_post","value":""},{"id":36575,"key":"_et_pb_truncate_post_date","value":""},{"id":36576,"key":"_et_pb_old_content","value":""},{"id":36577,"key":"_yoast_wpseo_primary_product_cat","value":"44"},{"id":36578,"key":"_yoast_wpseo_primary_atum_location","value":""},{"id":36579,"key":"_yoast_wpseo_linkdex","value":"33"},{"id":36580,"key":"_yoast_wpseo_content_score","value":"90"},{"id":36581,"key":"_yoast_wpseo_estimated-reading-time-minutes","value":"1"},{"id":36582,"key":"_yoast_wpseo_wordproof_timestamp","value":""},{"id":126469,"key":"_suggested_use","value":"Take five capsules daily, or as directed by your healthcare professional."},{"id":126470,"key":"_warnings","value":"Accidental overdose of iron-containing products is a leading cause of fatal poisoning in children under 6. Keep this product out of reach of children. In case of accidental overdose, call a doctor or poison control center immediately. Vitamin A: Excess vitamin A intake may be toxic and may increase the risk of birth defects. Pregnant women and women who may become pregnant should not exceed 1,500 mcg RAE (5,000 IU) of preformed vitamin A (retinyl acetate or retinyl palmitate) per day. Vitamin K: Consider total vitamin K intake (food and supplements) if you are taking blood-thinning medication. Consult your healthcare professional before use. Individuals taking medication should discuss potential interactions with their healthcare professional. Do not use if tamper seal is damaged. Storage: Keep closed in a cool, dry place out of reach of children."},{"id":126471,"key":"product_downloadables","value":"https:\/\/store.doctorsstudio.com\/wp-content\/uploads\/2025\/01\/Prenatal-Essentials-Capsules-150-ct_infosheet.pdf"},{"id":126472,"key":"product_ingredients","value":"<div>\r\n  <h1 style=\"color: white\">Supplement Facts<\/h1>\r\n  <p><strong>Serving Size:<\/strong> 5 Capsules<\/p>\r\n  <p><strong>Servings Per Container:<\/strong> 30<\/p>\r\n  <p><strong>Amount Per Serving:<\/strong><\/p>\r\n\r\n  <ul>\r\n    <li><strong>Vitamin A<\/strong> (60% as natural beta-carotene and 40% as retinyl palmitate): 1500 mcg (115% Daily Value)<\/li>\r\n    <li><strong>Vitamin C<\/strong> (ascorbic acid): 100 mg (83% Daily Value)<\/li>\r\n    <li><strong>Vitamin D3<\/strong> (cholecalciferol): 50 mcg (2000 IU) (333% Daily Value)<\/li>\r\n    <li><strong>Vitamin E<\/strong> (as d-alpha tocopheryl succinate): 134 mg (705% Daily Value)<\/li>\r\n    <li><strong>Thiamin<\/strong> (as thiamine HCl): 5 mg (357% Daily Value)<\/li>\r\n    <li><strong>Riboflavin<\/strong> (as riboflavin 5'-phosphate sodium): 5 mg (313% Daily Value)<\/li>\r\n    <li><strong>Niacin<\/strong> (as niacinamide): 25 mg (139% Daily Value)<\/li>\r\n    <li><strong>Vitamin B6<\/strong> (as pyridoxal 5'-phosphate): 20 mg (1000% Daily Value)<\/li>\r\n    <li><strong>Folate<\/strong> (as (6S)-5-methyltetrahydrofolic acid glucosamine salt<sup>S1<\/sup> and as calcium folinate): 1360 mcg DFE (227% Daily Value)<\/li>\r\n    <li><strong>Vitamin B12<\/strong> (as methylcobalamin): 50 mcg (1786% Daily Value)<\/li>\r\n    <li><strong>Biotin:<\/strong> 300 mcg (857% Daily Value)<\/li>\r\n    <li><strong>Pantothenic Acid<\/strong> (as d-calcium pantothenate): 25 mg (357% Daily Value)<\/li>\r\n    <li><strong>Choline<\/strong> (as choline dihydrogen citrate): 200 mg (36% Daily Value)<\/li>\r\n    <li><strong>Calcium<\/strong> (as dicalcium malate<sup>S2<\/sup>): 400 mg (31% Daily Value)<\/li>\r\n    <li><strong>Iron<\/strong> (as ferrous bisglycinate chelate<sup>S2<\/sup>): 30 mg (111% Daily Value)<\/li>\r\n    <li><strong>Iodine<\/strong> (as potassium iodide): 225 mcg (78% Daily Value)<\/li>\r\n    <li><strong>Magnesium<\/strong> (as dimagnesium malate<sup>S2<\/sup>): 200 mg (50% Daily Value)<\/li>\r\n    <li><strong>Zinc<\/strong> (as zinc bisglycinate chelate<sup>S2<\/sup>): 20 mg (154% Daily Value)<\/li>\r\n    <li><strong>Selenium<\/strong> (as L-selenomethionine): 100 mcg (143% Daily Value)<\/li>\r\n    <li><strong>Copper<\/strong> (as copper bisglycinate chelate<sup>S2<\/sup>): 2 mg (154% Daily Value)<\/li>\r\n    <li><strong>Manganese<\/strong> (as manganese bisglycinate chelate<sup>S2<\/sup>): 5 mg (192% Daily Value)<\/li>\r\n    <li><strong>Chromium<\/strong> (as chromium nicotinate glycinate chelate<sup>S2<\/sup>): 100 mcg (222% Daily Value)<\/li>\r\n    <li><strong>Molybdenum<\/strong> (as molybdenum glycinate chelate<sup>S2<\/sup>): 100 mcg (200% Daily Value)<\/li>\r\n    <li><strong>Vitamin K2<\/strong> (as menaquinone-7): 100 mcg (**)<\/li>\r\n  <\/ul>\r\n\r\n  <p>** Daily Value not established.<\/p>\r\n  <p>All Formulas Meet or Exceed cGMP Quality Standards.<\/p>\r\n\r\n  <h3 style=\"color: white\">Other Ingredients<\/h3>\r\n  <p>Capsule (hypromellose and water), microcrystalline cellulose, ascorbyl palmitate, silica, medium-chain triglyceride oil, and mixed tocopherols.<\/p>\r\n<\/div>\r\n"},{"id":224924,"key":"_main_inventory_expired_stock","value":""},{"id":224925,"key":"_main_inventory_is_expired","value":"no"},{"id":357105,"key":"_wcsatt_default_status","value":""},{"id":357107,"key":"_wcsatt_layout","value":"flat"},{"id":380599,"key":"_op_qty_warehouse_276941","value":""},{"id":380600,"key":"_hide_pos_website_276941","value":"yes"},{"id":380601,"key":"wcmo_product_restriction_method","value":"no-restriction"},{"id":380602,"key":"wcmo_product_user_ids","value":""},{"id":380603,"key":"wcmo_product_user_select","value":""},{"id":380604,"key":"wcmo_product_user_roles","value":""},{"id":380605,"key":"wcmo_hide_from_user_roles","value":""},{"id":380606,"key":"wcmo_product_exclude_from_archives","value":""},{"id":380607,"key":"wcmo_product_passwords","value":""},{"id":380608,"key":"wcmo_product_assign_roles","value":""},{"id":38
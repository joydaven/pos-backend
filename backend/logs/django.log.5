025\/01\/Organix-Phytofood-30-Servings_infosheet.pdf"},{"id":126347,"key":"product_ingredients","value":"<div>\r\n  <h1>Supplement Facts<\/h1>\r\n  <p><strong>Serving Size:<\/strong> 1 Scoop (about 8 g)<\/p>\r\n  <p><strong>Servings Per Container:<\/strong> About 30<\/p>\r\n  <p><strong>Amount Per Serving:<\/strong><\/p>\r\n\r\n  <ul>\r\n    <li><strong>Calories:<\/strong> 30<\/li>\r\n    <li><strong>Total Carbohydrate:<\/strong> 7 g (3%\u2020 Daily Value)<\/li>\r\n    <li><strong>Dietary Fiber:<\/strong> 4 g (14% Daily Value)<\/li>\r\n    <li><strong>Total Sugars:<\/strong> 1 g (**)<\/li>\r\n    <li><strong>Vitamin C<\/strong> (as ascorbic acid and naturally occurring vitamin C): 300 mg (333% Daily Value)<\/li>\r\n\r\n    <li><strong>Organic Fiber Blend:<\/strong>  \r\n      (Organic gum acacia, organic inulin, organic flaxseed) \u2013 4.275 g (**)\r\n    <\/li>\r\n\r\n    <li><strong>Organic Greens and Veggies Blend:<\/strong>  \r\n      (Organic carrot (<i>Daucus carota<\/i>)(whole), organic green cabbage (<i>Brassica oleracea var. capitata<\/i>)(whole), organic broccoli (<i>Brassica oleracea var. botrytis<\/i>)(whole), organic beet (<i>Beta vulgaris<\/i>)(root), organic chlorella (<i>Chlorella vulgaris<\/i>)(whole), organic spinach (<i>Spinacia oleracea<\/i>)(whole)) \u2013 1.28 g (**)\r\n    <\/li>\r\n\r\n    <li><strong>Organic Fruits and Berries Blend:<\/strong>  \r\n      (Organic blueberry (<i>Vaccinium corymbosum<\/i>)(whole), organic apple (<i>Malus domestica<\/i>)(whole), organic strawberry (<i>Fragaria spp.<\/i>)(whole), organic sea-buckthorn juice powder (<i>Hippophae rhamnoides<\/i>)(fruit), organic acai (<i>Euterpe oleracea<\/i>)(berry), organic acerola cherry extract (<i>Malpighia glabra<\/i>)(fruit), organic plum extract (<i>Prunus salicina<\/i>)(fruit)) \u2013 875 mg (**)\r\n    <\/li>\r\n\r\n    <li><strong>Antioxidant Phytonutrients Blend:<\/strong>  \r\n      (Organic green tea extract (<i>Camellia sinensis<\/i>)(leaf), organic apple extract (<i>Malus sieversii<\/i>)(whole), organic astragalus (<i>Astragalus membranaceus<\/i>)(root), organic ginger (<i>Zingiber officinale<\/i>)(root), organic goji berry extract (<i>Lycium spp.<\/i>)(fruit)) \u2013 710 mg (**)\r\n    <\/li>\r\n\r\n    <li><strong>Digestive Support<sup>*<\/sup> Blend:<\/strong>  \r\n      (Probiotics: <i>L. acidophilus, B. longum, L. casei, L. rhamnosus<\/i>; Enzymes: protease, amylase, bromelain, cellulase, lactase, lipase) \u2013 20 mg (**)\r\n    <\/li>\r\n\r\n    <li><strong>Glucoraphanin<\/strong> (from broccoli extract) (<i>Brassica oleracea var. italica<\/i>)(seed)<sup>S1<\/sup> \u2013 5 mg (**)<\/li>\r\n  <\/ul>\r\n\r\n  <p>\u2020 Percent Daily Values are based on a 2,000-calorie diet.<\/p>\r\n  <p>** Daily Value (DV) not established.<\/p>\r\n\r\n  <p><strong>Other Ingredients:<\/strong> Organic flavors, organic stevia extract, organic Luo Han Guo extract.<\/p>\r\n<\/div>\r\n"},{"id":224414,"key":"_main_inventory_expired_stock","value":""},{"id":224415,"key":"_main_inventory_is_expired","value":"no"},{"id":357015,"key":"_wcsatt_default_status","value":""},{"id":357017,"key":"_wcsatt_layout","value":"flat"},{"id":372023,"key":"_op_qty_warehouse_276941","value":""},{"id":372024,"key":"_hide_pos_website_276941","value":"yes"},{"id":372025,"key":"wcmo_product_restriction_method","value":"no-restriction"},{"id":372026,"key":"wcmo_product_user_ids","value":""},{"id":372027,"key":"wcmo_product_user_select","value":""},{"id":372028,"key":"wcmo_product_user_roles","value":""},{"id":372029,"key":"wcmo_hide_from_user_roles","value":""},{"id":372030,"key":"wcmo_product_exclude_from_archives","value":""},{"id":372031,"key":"wcmo_product_passwords","value":""},{"id":372032,"key":"wcmo_product_assign_roles","value":""},{"id":372033,"key":"wcmo_product_expires_after_value","value":""},{"id":372034,"key":"wcmo_product_expires_after_period","value":""},{"id":372035,"key":"wcmo_product_reminder_before_value","value":""},{"id":372036,"key":"wcmo_produc
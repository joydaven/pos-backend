div>\\r\\n  <h1 style=\\"color: white\\">Supplement Facts<\\/h1>\\r\\n  <p><strong>Serving Size:<\\/strong> 2 Capsules<\\/p>\\r\\n  <p><strong>Servings Per Container:<\\/strong> 60<\\/p>\\r\\n  <p><strong>Amount Per Serving:<\\/strong><\\/p>\\r\\n\\r\\n  <ul>\\r\\n    <li><strong>Folate (as (6S)-5-methyltetrahydrofolic acid, glucosamine salt):<\\/strong> 340 mcg DFE (85% Daily Value)<\\/li>\\r\\n    <li><strong>Calcium (as tricalcium phosphate and calcium d-glucarate tetrahydrate):<\\/strong> 75 mg (6% Daily Value)<\\/li>\\r\\n    <li><strong>Selenium (as methylselenocysteine):<\\/strong> 15 mcg (27% Daily Value)<\\/li>\\r\\n    <li><strong>Calcium D-Glucarate Tetrahydrate:<\\/strong> 250 mg (**)<\\/li>\\r\\n    <li><strong>Green Tea Aqueous Extract (Camellia sinensis) (leaf) (60% catechins, 30% EGCG, 6% caffeine):<\\/strong> 250 mg (**)<\\/li>\\r\\n    <li><strong>Alpha-Lipoic Acid:<\\/strong> 100 mg (**)<\\/li>\\r\\n    <li><strong>N-Acetyl-L-Cysteine:<\\/strong> 100 mg (**)<\\/li>\\r\\n    <li><strong>Milk Thistle Extract (Silybum marianum) (seed) (30% silybins):<\\/strong> 100 mg (**)<\\/li>\\r\\n    <li><strong>DIM (diindolylmethane):<\\/strong> 75 mg (**)<\\/li>\\r\\n    <li><strong>Quercetin (as quercetin dihydrate) (from Sophora japonica) (bud):<\\/strong> 50 mg (**)<\\/li>\\r\\n    <li><strong>Turmeric Extract (Curcuma longa) (rhizome) (95% curcuminoids):<\\/strong> 50 mg (**)<\\/li>\\r\\n    <li><strong>trans-Resveratrol (as Polygonum cuspidatum root extract):<\\/strong> 18.5 mg (**)<\\/li>\\r\\n    <li><strong>trans-Pterostilbene:<\\/strong> 15.5 mg (**)<\\/li>\\r\\n    <li><strong>Glucoraphanin (from broccoli extract) (Brassica oleracea italica) (seed):<\\/strong> 15 mg (**)<\\/li>\\r\\n    <li><strong>Dihydroquercetin:<\\/strong> 5 mg (**)<\\/li>\\r\\n    <li><strong>Black Pepper Extract (Piper nigrum) (fruit):<\\/strong> 5 mg (**)<\\/li>\\r\\n  <\\/ul>\\r\\n\\r\\n  <p>** Daily Value not established.<\\/p>\\r\\n\\r\\n  <h3 style=\\"color: white\\">Other Ingredients<\\/h3>\\r\\n  <p>Capsule (hypromellose and water), stearic acid, magnesium stearate, and silica.<\\/p>\\r\\n<\\/div>\\r\\n"},{"id":175668,"key":"_main_inventory_expired_stock","value":""},{"id":175669,"key":"_main_inventory_is_expired","value":"no"},{"id":357824,"key":"_subscription_one_time_shipping","value":"no"},{"id":357825,"key":"_wcsatt_default_status","value":""},{"id":357827,"key":"_wcsatt_force_subscription","value":"no"},{"id":357828,"key":"_wcsatt_layout","value":"flat"},{"id":377045,"key":"_op_barcode","value":""},{"id":377046,"key":"_op_weight_base_pricing","value":"no"},{"id":377047,"key":"_op_qty_decimal","value":"no"},{"id":377048,"key":"_op_qty_warehouse_276941","value":""},{"id":377049,"key":"_hide_pos_website_276941","value":"yes"},{"id":377050,"key":"wcmo_product_restriction_method","value":"no-restriction"},{"id":377051,"key":"wcmo_product_user_ids","value":""},{"id":377052,"key":"wcmo_product_user_select","value":""},{"id":377053,"key":"wcmo_product_user_roles","value":""},{"id":377054,"key":"wcmo_hide_from_user_roles","value":""},{"id":377055,"key":"wcmo_product_exclude_from_archives","value":""},{"id":377056,"key":"wcmo_product_passwords","value":""},{"id":377057,"key":"wcmo_product_assign_roles","value":""},{"id":377058,"key":"wcmo_product_expires_after_value","value":""},{"id":377059,"key":"wcmo_product_expires_after_period","value":""},{"id":377060,"key":"wcmo_product_reminder_before_value","value":""},{"id":377061,"key":"wcmo_product_reminder_before_period","value":""},{"id":377062,"key":"wcmo_product_sub_cancelled_roles","value":""},{"id":377063,"key":"_wc_memberships_use_custom_product_viewing_restricted_message","value":"no"},{"id":377064,"key":"_wc_memberships_use_custom_product_purchasing_restricted_message","value":"no"},{"id":377065,"key":"_wc_memberships_force_public","value":"no"},{"id":377066,"key":"_wc_memberships_exclude_discounts","value":"no"},{"id":377067,"key":"wpf-settings-woo","value":[]},{"id":377068,"key":